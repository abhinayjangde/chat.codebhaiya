{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ]
    },
    "sarvam": {
      "command": "uvx",
      "args": [
        "sarvam-mcp"
      ],
      "env": {
        "SARVAM_API_KEY": "${env:SARVAM_API_KEY}"
      }
    }
  }
}