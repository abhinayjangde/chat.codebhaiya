# Server
PORT=9000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
MONGODB_URL=mongodb://localhost:27017/chatbhaiya

# Auth (minimum 32 chars each)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_another_long_random_secret_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# LLM
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Optional
GOOGLE_API_KEY=
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2
OLLAMA_API_KEY=
MODEL_NAME=

# Document storage (AWS S3 or an S3-compatible provider)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional: use this for an S3-compatible provider such as MinIO or R2
AWS_S3_ENDPOINT=
# AWS credentials are read from the standard AWS environment/role chain.

# Managed Qdrant Cloud
QDRANT_URL=https://your-cluster.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=chat_documents

# Managed Redis (TLS URLs such as rediss:// are supported)
REDIS_URL=rediss://default:password@your-redis-host:6379
DOCUMENT_QUEUE_NAME=document-processing
